# ─────────────────────────────────────────────────────────────
# Small Property's Real State — Environment variables
# Copy this file to ".env" and fill in your Supabase project values.
# (In Netlify, add these same keys under Site settings → Environment variables)
# ─────────────────────────────────────────────────────────────

# Your shared Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project "anon" public key (Project Settings → API)
VITE_SUPABASE_ANON_KEY=

# Table/Storage prefix so this website does NOT collide with your other
# websites inside the SAME shared Supabase project. Default: sc_
# (Tables become: sc_properties, sc_leads ; Storage bucket: sc-media)
VITE_DB_PREFIX=sc_
